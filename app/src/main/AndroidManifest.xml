<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification permission for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Custom permission for service control (signature-level protection) -->
    <permission
        android:name="com.example.udpbroker.permission.CONTROL_SERVICE"
        android:protectionLevel="signature"
        android:description="@string/permission_control_service_description"
        android:label="@string/permission_control_service_label" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UDPBroker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.UDPBroker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Broadcast receiver for controlling service via adb (signature-protected) -->
        <receiver
            android:name=".ServiceControlReceiver"
            android:exported="true"
            android:permission="com.example.udpbroker.permission.CONTROL_SERVICE">
            <intent-filter>
                <action android:name="com.example.udpbroker.START_SERVICE" />
                <action android:name="com.example.udpbroker.STOP_SERVICE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
